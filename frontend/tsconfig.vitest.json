{
  "extends": "./tsconfig.app.json",
  "include": ["env.d.ts", "src/**/*", "tests/**/*.ts"],
  "exclude": ["src/components/unused"],
  "compilerOptions": {
    "lib": [],
    "skipLibCheck": true,
    "types": ["node", "jsdom"],
    "composite": true,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler"
  }
}
