DJANGO_SALT=HighlySecureSalt
TEST_RUN=False
TEST_RUN_FRAME_NUMBER=1000
RUST_BACKTRACE=1
STORAGE_DIR=data/
ENV_PATH=./.env
DJANGO_PSEUDO_DIR=/home/admin/test-data
DJANGO_SETTINGS_MODULE=lx_annotate.settings_dev
DJANGO_DEBUG=True
DJANGO_FFMPEG_EXTRACT_FRAME_BATCHSIZE=500

# Same provider settings as report import; the model must already be installed.
LLM_ENABLED=true
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=lx-gemma4-e2b-json
LLM_TIMEOUT=120
# Remote endpoints require HTTPS and configured LLM_CA_FILE,
# LLM_CLIENT_CERT_FILE and LLM_CLIENT_KEY_FILE handles.
