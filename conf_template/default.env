# Identity salts are injected at runtime through secretspec.identity.toml.
# Never place salt values or bundles in this file.
TEST_RUN=False
TEST_RUN_FRAME_NUMBER=1000
RUST_BACKTRACE=1
# Set LX_RUNTIME_ROOT to an absolute path; devenv supplies <checkout>/data.
ENV_PATH=./.env
DJANGO_PSEUDO_DIR=/home/admin/test-data
DJANGO_SETTINGS_MODULE=lx_annotate.settings_dev
DJANGO_DEBUG=True
DJANGO_FFMPEG_EXTRACT_FRAME_BATCHSIZE=500
# Disabled without the LuxNix request resource controller.
LX_ANNOTATE_REQUEST_THROTTLE_DIRECTORY=

# Study-independent local intake; use a distinct stable key for each site.
# Blank key retains legacy CENTER_NAME lookup, then derives a key from its name.
LX_ANNOTATE_DEFAULT_CENTER=
CENTER_NAME=Local Center

# Same provider settings as report import; the model must already be installed.
LLM_ENABLED=true
# Reporting-shell KI-Bericht button; clinical data goes to the local Ollama server.
# Set to true only after privacy sign-off. Only Ollama is supported.
REPORT_LLM_DRAFTING_ENABLED=false
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=lx-gemma4-e2b-json
LLM_TIMEOUT=120
# Remote endpoints require HTTPS and configured LLM_CA_FILE,
# LLM_CLIENT_CERT_FILE and LLM_CLIENT_KEY_FILE handles.
